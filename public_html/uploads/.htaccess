# Uploaded files must never be executed as scripts.
Options -Indexes -ExecCGI
<FilesMatch "\.(php|phtml|php[0-9]|phar|pl|py|cgi|asp|aspx|jsp|sh|shtml|htaccess|html?|svg|js)$">
    Require all denied
</FilesMatch>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
RemoveHandler .php .phtml .php5 .php7 .php8
RemoveType .php .phtml .php5 .php7 .php8
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'none'; sandbox"
</IfModule>
