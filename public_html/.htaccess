# =====================================================================
# Prerit Welfare Foundation - Apache / LiteSpeed configuration
# =====================================================================

Options -Indexes
DirectoryIndex index.php
ServerSignature Off

# ---------------------------------------------------------------------
# Block direct access to include files, configuration and data files
# ---------------------------------------------------------------------
<FilesMatch "^(config|database|functions|header|footer|auth|mail|validation|csrf)\.php$">
    Require all denied
</FilesMatch>
# includes/ and templates/ also carry their own "deny all" .htaccess
<FilesMatch "\.(sql|md|log|ini|bak|old|orig|swp|dist|env|json|lock|sh|yml|yaml)$">
    Require all denied
</FilesMatch>
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Canonical address: https://preritwelfarefoundation.org (HTTPS, no www), the same as BASE_URL in config.php.
    # One permanent (301) redirect, path and query string kept, for pages and static files alike:
    #   http://www.preritwelfarefoundation.org/x  and  https://www.preritwelfarefoundation.org/x  -> https://preritwelfarefoundation.org/x
    #   http://preritwelfarefoundation.org/x                                                     -> https://preritwelfarefoundation.org/x
    # The rules match ONLY these two host names, so localhost, staging copies, preview and temporary hosting
    # addresses are never redirected. The live site has an SSL certificate (Hostinger free SSL); hPanel "Force HTTPS"
    # may stay on as well (it gives the same single hop). If the domain ever changes, edit both host names here and
    # BASE_URL together. /.well-known/ (SSL certificate renewal checks) is left alone.
    RewriteCond %{REQUEST_URI} !^/\.well-known/
    RewriteCond %{HTTP_HOST} ^www\.preritwelfarefoundation\.org(?::(?:80|443))?$ [NC]
    RewriteRule ^ https://preritwelfarefoundation.org%{REQUEST_URI} [L,R=301]
    RewriteCond %{REQUEST_URI} !^/\.well-known/
    RewriteCond %{HTTP_HOST} ^preritwelfarefoundation\.org(?::(?:80|443))?$ [NC]
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
    RewriteRule ^ https://preritwelfarefoundation.org%{REQUEST_URI} [L,R=301]

    # Generic form of the same two rules (for a copy of the site on another domain), kept for reference:
    #   force HTTPS:     RewriteCond %{HTTPS} off  +  RewriteCond %{HTTP:X-Forwarded-Proto} !https
    #                    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
    #   force non-www:   RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    #                    RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

    # Block access to hidden files/folders such as .git
    RewriteRule (^|/)\.(?!well-known/) - [F,L]

    # Pass the Authorization header to PHP (some hosts strip it)
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Clean URLs: everything that is not a real file or folder goes to the front controller
    # (/about/, /campaign/bihar-flood-relief/, /sitemap.xml, old *.php addresses -> 301 redirects)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L,QSA]
</IfModule>

# ---------------------------------------------------------------------
# Security headers: also applied to static files. PHP sends the same headers for pages; "set" (not "always set")
# replaces PHP's copy instead of adding a second one.
# ---------------------------------------------------------------------
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    # setifempty: private pages (event joining links) may send a stricter no-referrer policy from PHP
    Header setifempty Referrer-Policy "strict-origin-when-cross-origin"
    Header unset X-Powered-By
</IfModule>

# ---------------------------------------------------------------------
# Error pages
# ---------------------------------------------------------------------
ErrorDocument 403 "Forbidden"
ErrorDocument 404 /index.php

# ---------------------------------------------------------------------
# Compression & browser caching for static files
# ---------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml application/json text/plain application/xml text/xml text/calendar
</IfModule>
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType image/png "access plus 6 months"
    ExpiresByType image/jpeg "access plus 6 months"
    ExpiresByType image/webp "access plus 6 months"
    ExpiresByType image/svg+xml "access plus 6 months"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
<IfModule mod_mime.c>
    AddType font/woff2 .woff2
    AddType image/webp .webp
</IfModule>
